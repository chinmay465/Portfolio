<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <com.chinmay.swar.web.SwarWebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/page_bg" />

    <!-- Audio quality, on YouTube Music's full-screen player only -->
    <TextView
        android:id="@+id/quality_chip"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_quality_chip"
        android:clickable="true"
        android:drawableStart="@drawable/ic_quality"
        android:drawablePadding="6dp"
        android:elevation="4dp"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Shown until YouTube Music has drawn its UI -->
    <LinearLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_aurora"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <com.chinmay.swar.ui.EqualizerView
            android:id="@+id/loading_eq"
            android:layout_width="88dp"
            android:layout_height="72dp" />

        <TextView
            android:id="@+id/loading_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.42"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="@color/text_primary"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/loading_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.2"
            android:text="@string/app_name_devanagari"
            android:textColor="@color/text_secondary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/loading_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:letterSpacing="0.08"
            android:text="@string/loading_status"
            android:textColor="@color/text_tertiary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Music video -> song: shown while Swar switches, so it doesn't feel stuck -->
    <FrameLayout
        android:id="@+id/switching"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B805060B"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/switching_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/bg_switch_card"
            android:elevation="16dp"
            android:outlineAmbientShadowColor="@color/brand"
            android:outlineSpotShadowColor="@color/brand_2"
            android:gravity="center_vertical"
            android:minWidth="240dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <com.chinmay.swar.ui.EqualizerView
                android:layout_width="34dp"
                android:layout_height="28dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/switching_title"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/switching_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxWidth="220dp"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Can't load: offline or YouTube unreachable -->
    <LinearLayout
        android:id="@+id/offline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_aurora"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/offline_icon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_offline_icon"
            android:contentDescription="@null"
            android:padding="28dp"
            android:src="@drawable/ic_offline"
            android:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/offline_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/offline_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/offline_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/offline_message"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/offline_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:elevation="8dp"
            android:outlineAmbientShadowColor="@color/brand"
            android:outlineSpotShadowColor="@color/brand_2"
            android:paddingStart="36dp"
            android:paddingTop="14dp"
            android:paddingEnd="36dp"
            android:paddingBottom="14dp"
            android:text="@string/offline_retry"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Page load progress, above everything -->
    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@drawable/progress_line"
        android:visibility="invisible" />
</FrameLayout>
