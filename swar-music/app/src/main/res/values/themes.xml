<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Swar" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/brand</item>
    </style>

    <!-- Launch screen: animated equalizer on the app's background, then Theme.Swar. -->
    <style name="Theme.Swar.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/page_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.Swar</item>
    </style>
</resources>
