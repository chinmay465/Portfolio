<?xml version="1.0" encoding="utf-8"?>
<!-- Glass chip with a 1dp cyan-to-violet edge -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#335B8CFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="0"
                        android:centerColor="@color/brand"
                        android:endColor="@color/brand_2"
                        android:startColor="@color/brand_0" />
                </shape>
            </item>
            <item
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="15dp" />
                    <solid android:color="#E60C0E1A" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
