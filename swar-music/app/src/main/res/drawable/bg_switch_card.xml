<?xml version="1.0" encoding="utf-8"?>
<!-- Glass card with a 1dp gradient edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="0"
                android:centerColor="@color/brand"
                android:endColor="@color/brand_2"
                android:startColor="@color/brand_0" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <gradient
                android:angle="270"
                android:endColor="#F70A0B14"
                android:startColor="#F7141830" />
        </shape>
    </item>
</layer-list>
