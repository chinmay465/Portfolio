<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lists launcher apps for "Apps that skip the proxy" (no QUERY_ALL_PACKAGES). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kavach">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Kavach On" / "Kavach Off": extra launcher entries for automation
             apps (Samsung Modes and Routines → "Open an app"). Transparent,
             close immediately, own task so the app you were in stays in front. -->
        <activity
            android:name=".KavachOnActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/quick_on_label"
            android:noHistory="true"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:taskAffinity=""
            android:theme="@style/Theme.Kavach.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".KavachOffActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@mipmap/ic_launcher_off"
            android:label="@string/quick_off_label"
            android:noHistory="true"
            android:roundIcon="@mipmap/ic_launcher_off"
            android:taskAffinity=""
            android:theme="@style/Theme.Kavach.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Local VPN. Only DNS traffic is routed into it; everything else
             goes straight to the network, or to Kavach's loopback proxy in
             proxy mode. -->
        <service
            android:name=".vpn.AdBlockVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local DNS-filtering VPN that blocks ad and tracker domains" />
        </service>
    </application>
</manifest>
